+export function toTransactionRow(tx: ResaleTransaction): TransactionRow | null {
+  if (parseStoreyMidpoint(tx.storeyRange) == null) return null;
+  return {
+    month: tx.month,
+    town: tx.town,
+    block: tx.block,
+    street_name: tx.streetName,
