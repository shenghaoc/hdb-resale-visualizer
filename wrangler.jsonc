{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hdb-resale-visualizer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
  },
  // Workers Builds / `wrangler deploy` must produce `dist/` before uploading assets.
  // Dashboard build_command can stay empty when deploy runs `npx wrangler deploy`.
  "build": {
    "command": "pnpm build:deploy",
  },
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"] },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hdb-resale",
      "database_id": "df06858c-8fd3-4cf5-9080-dbd9a9f49250",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "SHORTLIST_WRITE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  // Public-read backend selector (worker/public-read-backend.ts). D1 is the default and the rollback
  // target; "neon" additionally requires the HDB_PUBLIC_NEON Hyperdrive binding. Private shortlist
  // storage and the TTL cleanup always stay on D1. Changing an epoch retires every cached public
  // response for that backend (Cache API keys are namespaced `<backend>-<epoch>`).
  "vars": {
    "PUBLIC_DATA_BACKEND": "d1",
    "D1_PUBLIC_CACHE_EPOCH": "d1-cutover-v1",
  },
  "triggers": {
    "crons": ["0 3 * * *"],
  },
}
