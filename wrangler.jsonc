{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hdb-resale-visualizer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
  },
  // Workers Builds / `wrangler deploy` must produce `dist/` before uploading assets.
  // Dashboard build_command can stay empty when deploy runs `npx wrangler deploy`.
  "build": {
    "command": "pnpm build:deploy",
  },
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"] },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hdb-resale",
      "database_id": "df06858c-8fd3-4cf5-9080-dbd9a9f49250",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "SHORTLIST_WRITE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  // Public-read backend selector (worker/public-read-backend.ts). Public reads are served from Neon
  // through the Hyperdrive config below (direct endpoint, SELECT-only role, query cache disabled,
  // origin connection limit 5). D1 stays bound for private shortlists and the TTL cleanup, and is the
  // rollback target: set PUBLIC_DATA_BACKEND back to "d1" (or promote the previous Worker version).
  // Changing an epoch retires every cached public response for that backend (Cache API keys are
  // namespaced `<backend>-<epoch>`); change NEON_PUBLIC_CACHE_EPOCH whenever the Neon data changes.
  "hyperdrive": [
    {
      "binding": "HDB_PUBLIC_NEON",
      "id": "70f9a7f0a2f64851af0cccba58dcfb0c",
    },
  ],
  "vars": {
    "PUBLIC_DATA_BACKEND": "neon",
    "D1_PUBLIC_CACHE_EPOCH": "d1-cutover-v1",
    "NEON_PUBLIC_CACHE_EPOCH": "neon-20261007-1",
  },
  "triggers": {
    "crons": ["0 3 * * *"],
  },
}
