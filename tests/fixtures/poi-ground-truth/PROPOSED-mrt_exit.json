  "labellingProtocol": ".kiro/specs/poi-source-integration/design.md#labelling-protocol",
  "classSemantics": "proposedClass is the strength-of-evidence class that the rule table in design.md assigns to the two records shown, independent of whether either source is admitted. proposedRelationHolds is the separate truth proposal (yes, no, part-of, undetermined, no-counterpart-in-sample) the owner is asked to confirm or correct.",
  "relationVocabulary": {
    "same-entity": "The two records describe the same real-world place.",
    "same-physical-exit": "Two records inside one source that might describe one physical exit (intra-source duplicate check).",
    "exit-belongs-to-station-footprint": "An exit point and a station outline: membership, not identity.",
    "intra-source-sibling": "Two records of one source that might be mistaken for each other."
  },
  "classVocabulary": {
    "verified": "Two independent sources agree on identity through a shared key or exact name AND tight geometry, uniquely (rule ids R-VER-*).",
    "rule-supported": "No shared key, but one named rule in design.md is satisfied by a unique mutual candidate (rule ids R-RS-*).",
    "ambiguous": "More than one candidate, conflicting channels, granularity mismatch, or too little evidence. Never auto-merged (rule ids R-AMB-*).",
    "unmatched": "No candidate in the other sampled source satisfies even the weakest rule (R-UNM-NO-CANDIDATE). It says nothing about whether the place exists.",
    "rejected": "A candidate that passed blocking and failed a hard-negative rule (rule ids R-REJ-*). Kept so it is never re-proposed."
  },
  "ruleVocabulary": {
    "R-AMB-CHANNEL-CONFLICT": "Name exact but geometry beyond the wide band, or key conflict.",
    "R-AMB-GEO-ONLY": "Geometry agrees, names disagree or one is address-style.",
    "R-AMB-INTRA-COLLISION": "Intra-source: two records of one source with equal identity key (label and exit code, or licensee and postal code) and positions within the block radius. Never merged automatically; both kept and flagged.",
    "R-REJ-INTRA-DISTINCT-KEY": "Intra-source: two records of one source with different identity keys (exit code, licensee). Distinct by construction.",
    "R-REJ-INTRA-FAR": "Intra-source: equal identity key but beyond the block radius. Distinct entities that collide on the key.",
    "R-REJ-LIFECYCLE": "Lifecycle or subtype conflict (under construction vs existing, MRT vs LRT, monorail, former railway).",
    "R-RS-REGISTRY-CODE": "The label is a station code resolved to a name by a registry, that name matches the other record, and the geometry is within the tight or wide band.",
    "R-RS-SPATIAL-ONLY": "One side has no usable name (null or a code with no registry row); geometry within the tight band; unique candidate. Stations only.",
    "R-VER-NAME-GEO": "No key; name exact AND geometry within the tight band, unique mutual candidate."
  },
