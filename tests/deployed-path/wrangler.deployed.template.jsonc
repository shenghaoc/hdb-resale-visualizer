{
  // TEMPORARY real-path verification Worker. Never use serving-branch credentials.
  // Needs TWO disposable Hyperdrive configs: existing SELECT-only spatial reader and
  // a minimal budget role that can only EXECUTE public.reserve_nearby_statement(integer).
  // It intentionally has no D1 binding. The database migration belongs on the test Neon fork.
  "name": "__WORKER_NAME__",
  "main": "__REPO_ROOT__/worker/index.ts",
  "compatibility_date": "2026-04-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"] },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"] },
  ],
  "ratelimits": [
    {
      "name": "NEARBY_IP_LIMITER",
      "namespace_id": "9003",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "NEARBY_ORIGIN_LIMITER",
      "namespace_id": "9004",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  "hyperdrive": [
    {
      "binding": "HDB_PUBLIC_NEON",
      "id": "__HYPERDRIVE_ID__",
      "localConnectionString": "postgresql://local:local@localhost:5432/hdb_local",
    },
    {
      "binding": "HDB_NEARBY_BUDGET",
      "id": "__BUDGET_HYPERDRIVE_ID__",
      "localConnectionString": "postgresql://local:local@localhost:5432/hdb_local",
    },
  ],
  "vars": {
    "PUBLIC_DATA_BACKEND": "neon",
    "D1_PUBLIC_CACHE_EPOCH": "unused",
    "NEON_PUBLIC_CACHE_EPOCH": "__CACHE_EPOCH__",
    "NEON_SPATIAL_ENABLED": "true",
    "NEARBY_DAILY_STATEMENT_CEILING": "__CEILING__",
  },
}
