{
  "name": "hdb-resale-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:functions": "pnpm build && wrangler dev --var PUBLIC_DATA_BACKEND:d1",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "build": "pnpm check:boundaries && tsc -b && vp build && pnpm check:bundle",
    "build:full": "pnpm check:boundaries && pnpm sync-data && tsc -b && vp build && pnpm check:bundle",
    "build:deploy": "pnpm check:boundaries && tsc -b && vp build && pnpm check:bundle",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "check:pr": "pnpm run check && pnpm test:e2e",
    "db:migrate:local": "wrangler d1 migrations apply hdb-resale --local",
    "db:migrate:remote": "wrangler d1 migrations apply hdb-resale --remote",
    "preview": "vp preview",
    "typecheck": "tsc -b",
    "typecheck:libs": "tsc --noEmit -p tsconfig.lib-check.json",
    "setup:fixtures": "tsx scripts/setup-api-fixtures.ts",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint .",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vp test run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vp test",
    "test:listing-check": "NODE_OPTIONS=--no-experimental-webstorage vp test run listing ListingCheckPanel",
    "test:comparables": "NODE_OPTIONS=--no-experimental-webstorage vp test run comparable time-adjustment transaction-analysis transaction-outliers",
    "test:buyer-workflow": "NODE_OPTIONS=--no-experimental-webstorage vp test run shortlist buyer-first",
    "test:browser": "VITEST_BROWSER=1 NODE_OPTIONS=--no-experimental-webstorage vp test run --browser=chromium tests/browser",
    "test:browser:watch": "VITEST_BROWSER=1 NODE_OPTIONS=--no-experimental-webstorage vp test --browser=chromium tests/browser",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/production-bootstrap.spec.ts tests/e2e/app.spec.ts tests/e2e/accessibility.spec.ts",
    "test:e2e:reuse": "E2E_REUSE_SERVER=1 playwright test",
    "sync-data": "tsx scripts/sync-data.ts",
    "sync-data:neon": "tsx scripts/sync-neon.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.48.0",
    "maplibre-gl": "^6.7.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^4.20260604.1",
    "@electric-sql/pglite": "^0.5.8",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@neondatabase/serverless": "^1.2.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "^4.13.0",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "papaparse": "^5.7.0",
    "pg-copy-streams": "^7.0.0",
    "playwright": "1.62.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "catalog:",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.128.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
