{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals", "@cloudflare/workers-types"]
  },
  "include": [
    "src/vite-env.d.ts",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "tests/setup.ts",
    "cloudflare-env.d.ts"
  ],
  // neon-pilot-entrypoint.test.ts imports the pilot's git-ignored private scratch state (.neon-benchmark/),
  // which does not exist in a checkout; see NEEDS_PRIVATE_PILOT_STATE in vitest.config.ts.
  "exclude": ["tests/e2e/**", "tests/unit/neon-pilot-entrypoint.test.ts"]
}
